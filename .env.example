# HarvestLens AI Environment Configuration Example

# Server Host & Port
HOST=127.0.0.1
PORT=8000

# Security (Change in production)
SECRET_KEY=harvestlens-ai-secret-key-production-farm-auth-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database URL (SQLite by default, or PostgreSQL e.g. postgresql://user:pass@localhost:5432/harvestlens)
DATABASE_URL=sqlite:///./harvestlens.db

# YOLOv8 Model Configuration
DEFAULT_CONFIDENCE=0.25
